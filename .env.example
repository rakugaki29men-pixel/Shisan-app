# Firebaseプロジェクトの「Webアプリを登録」で表示される firebaseConfig の値を入れてください。
# Renderにデプロイする場合は、これらをRenderの環境変数（Environment Variables）に
# 同じキー名で設定してください。空のままなら「誰かと共有」機能は無効になり、
# 今まで通りローカル保存のみで動作します。
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# 開発時にFirebaseエミュレーターを使う場合のみ true にする
VITE_USE_FIREBASE_EMULATOR=false
