rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isSignedIn() {
      return request.auth != null;
    }
    function isHouseholdMember(householdId) {
      return isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/households/$(householdId)).data.members;
    }

    match /users/{uid} {
      allow read, write: if isSignedIn() && request.auth.uid == uid;
    }

    match /households/{householdId} {
      allow get: if isHouseholdMember(householdId);
      allow list: if false;

      allow create: if isSignedIn() &&
        request.resource.data.members is list &&
        request.resource.data.members.size() == 1 &&
        request.resource.data.members[0] == request.auth.uid;

      allow update: if isSignedIn() && (
        // 既存メンバーによる更新（他のメンバーの削除はできない）
        (request.auth.uid in resource.data.members &&
         request.resource.data.members.hasAll(resource.data.members)) ||
        // 招待コードでの新規参加：自分自身をメンバーに1人だけ追加する場合のみ許可
        (!(request.auth.uid in resource.data.members) &&
         request.resource.data.members.hasAll(resource.data.members) &&
         request.resource.data.members.size() == resource.data.members.size() + 1 &&
         request.auth.uid in request.resource.data.members) ||
        // 退出：自分自身だけをメンバーから外す場合のみ許可
        (request.auth.uid in resource.data.members &&
         !(request.auth.uid in request.resource.data.members) &&
         request.resource.data.members.size() == resource.data.members.size() - 1 &&
         resource.data.members.hasAll(request.resource.data.members))
      );

      allow delete: if false;

      match /data/{doc} {
        allow read, write: if isHouseholdMember(householdId);
      }
    }

    match /inviteCodes/{code} {
      allow get: if isSignedIn();
      allow list: if false;
      allow create: if isSignedIn() && isHouseholdMember(request.resource.data.householdId);
      allow update, delete: if isSignedIn() && isHouseholdMember(resource.data.householdId);
    }
  }
}
